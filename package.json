{
  "name": "gamify-leet",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run dev:tui",
    "dev:api": "node scripts/run-api.mjs",
    "dev:web": "pnpm --filter gamify-leet-web dev",
    "dev:tui": "mprocs",
    "setup:hooks": "node scripts/setup-githooks.mjs",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,py,json}\""
  },
  "devDependencies": {
    "turbo": "latest",
    "prettier": "^3.3.0"
  },
  "packageManager": "pnpm@9.15.0"
}
