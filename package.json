{
  "name": "gamify-leet",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run dev:tui",
    "dev:api": "node scripts/run-api.mjs",
    "dev:web": "pnpm --filter gamify-leet-web dev",
    "dev:tui": "mprocs",
    "setup:hooks": "node scripts/setup-githooks.mjs",
    "lint": "eslint .",
    "build": "turbo build",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,py,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.3.0",
    "turbo": "latest",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@9.15.0"
}
