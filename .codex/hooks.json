{
  "description": "Format source files after Codex edits.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/format-after-edit.mjs",
            "statusMessage": "Formatting edited files"
          }
        ]
      }
    ]
  }
}
